# =====================================================================
# AX.25 TNC INTERFACE CONTROL VARIABLES
# =====================================================================

# Paradigm Mode: Set to "P2P" for Point-to-Point, or "ETHERNET" for Multipoint Broadcast
NETWORK_MODE="P2P"

# --- Option A: Point-to-Point Configuration Variables ---
P2P_LOCAL_IP="10.0.0.1"
P2P_REMOTE_IP="10.0.0.2"
P2P_MTU="496"

# --- Option B: Point-to-Multipoint Configuration Variables ---
ETH_CIDR_IP="10.91.0.1/24"
ETH_MTU="482"
